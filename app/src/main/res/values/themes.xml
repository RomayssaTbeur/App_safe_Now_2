    <!-- ══════════════════════════════════════════════════════════════
         Bouton BASE — parent de tous les boutons SafeNow
         Parent MaterialComponents (pas Material3) = pas de Material You
         ══════════════════════════════════════════════════════════════ -->
    <style name="Widget.SafeNow.Button.Base" parent="Widget.MaterialComponents.Button">
        <item name="android:fontFamily">@font/space_grotesk</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <!-- ══════════════════════════════════════════════════════════════
         Bouton Primary (Send Code — écran Login)
         ══════════════════════════════════════════════════════════════ -->
    <style name="Widget.SafeNow.Button.Primary" parent="Widget.SafeNow.Button.Base">
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="backgroundTint">#00407A</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">16dp</item>
        <item name="elevation">8dp</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <!-- ══════════════════════════════════════════════════════════════
         Bouton Verify (écran OTP) — CORRECTION PRINCIPALE
         Couleur hex directe pour contourner le bug Material You
         ══════════════════════════════════════════════════════════════ -->
    <style name="Widget.SafeNow.Button.Verify" parent="Widget.SafeNow.Button.Base">
        <item name="backgroundTint">#002A54</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">16dp</item>
        <item name="cornerRadius">40dp</item>
        <item name="elevation">8dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <!-- ══════════════════════════════════════════════════════════════
         Champs OTP
         ══════════════════════════════════════════════════════════════ -->
    <style name="Widget.SafeNow.OtpInput" parent="">
        <item name="android:background">@drawable/bg_otp_input_adaptive</item>
        <item name="android:textColor">@color/primary</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">@font/space_grotesk</item>
        <item name="android:gravity">center</item>
        <item name="android:inputType">number</item>
        <item name="android:maxLength">1</item>
        <item name="android:imeOptions">actionNext</item>
    </style>


    <style name="Theme.Safe_now_2" parent="Base.Theme.Safe_now_2" />
