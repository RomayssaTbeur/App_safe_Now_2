<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- HEADER -->
    <include
        android:id="@+id/header"
        layout="@layout/header" />
    <!-- ══════════════════════════════ -->
    <!--        CONTENU PRINCIPAL      -->
    <!-- ══════════════════════════════ -->


    <!-- FOOTER -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingBottom="100dp"
        android:layout_marginTop="72dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="24dp"
            android:paddingBottom="24dp">

            <!-- ── Hero Title ── -->

            <TextView
                android:id="@+id/tv_hero_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="-0.03"
                android:lineSpacingMultiplier="1.1"
                android:text="Immersion\nPreparation"
                android:textColor="@color/hero_title_color"
                android:textSize="40sp" />

            <TextView
                android:id="@+id/tv_hero_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="32dp"
                android:lineSpacingMultiplier="1.5"
                android:text="Select your training environment. Each simulation is calibrated to real-world physiological stress levels to ensure behavioral retention."
                android:textColor="@color/body_text_color"
                android:textSize="15sp" />

            <!-- ══════════════════════════════ -->
            <!--     SCENARIO CARDS            -->
            <!-- ══════════════════════════════ -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="32dp"
                android:orientation="horizontal"
                android:weightSum="2">

                <!-- Card Fire (Selected) -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/card_fire"
                    android:layout_width="0dp"
                    android:layout_height="220dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@color/scenario_card_bg"
                    app:cardCornerRadius="28dp"
                    app:cardElevation="8dp"
                    app:cardUseCompatPadding="false"
                    app:cardPreventCornerOverlap="true">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clipToOutline="true"
                        android:background="@android:color/transparent">

                        <!-- Image de fond -->
                        <ImageView
                            android:id="@+id/img_fire"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:alpha="0.4"
                            android:contentDescription="Fire scenario"
                            android:scaleType="centerCrop"
                            android:src="@drawable/img_fire" />


                        <!-- Contenu bas -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="20dp"
                            app:layout_constraintBottom_toBottomOf="parent">

                            <ImageView
                                android:layout_width="30dp"
                                android:layout_height="30dp"
                                android:layout_marginBottom="8dp"
                                android:contentDescription="Fire icon"
                                android:src="@drawable/ic_fire"
                                android:clipToOutline="true"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Fire"
                                android:textColor="@color/black"
                                android:textSize="20sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="High Heat • Zero Visibility"
                                android:textColor="@color/black"
                                android:textSize="11sp" />

                        </LinearLayout>


                    </androidx.constraintlayout.widget.ConstraintLayout>

                </androidx.cardview.widget.CardView>

                <!-- Card Earthquake  -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/card_earthquake"
                    android:layout_width="0dp"
                    android:layout_height="220dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@color/scenario_card_bg"
                    app:cardCornerRadius="28dp"
                    app:cardElevation="4dp"
                    app:cardUseCompatPadding="false"
                    app:cardPreventCornerOverlap="true">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clipToOutline="true"
                        android:background="@android:color/transparent">

                        <!-- Image de fond -->
                        <ImageView
                            android:id="@+id/img_earthquake"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:alpha="0.15"
                            android:contentDescription="Earthquake scenario"
                            android:scaleType="centerCrop"
                            android:src="@drawable/img_earthquake"
                            android:clipToOutline="true"/>

                        <!-- Contenu bas -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="20dp"
                            app:layout_constraintBottom_toBottomOf="parent">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_marginBottom="8dp"
                                android:contentDescription="Earthquake icon"
                                android:src="@drawable/ic_vibrate"
                                app:tint="@color/black" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Earthquake"
                                android:textColor="@color/black"
                                android:textSize="20sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="Magnitude 7.2 • Structural Failure"
                                android:textColor="@color/black"
                                android:textSize="11sp" />

                        </LinearLayout>

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </androidx.cardview.widget.CardView>

            </LinearLayout>


            <!-- ══════════════════════════════ -->
            <!--     BOUTON START SIMULATION   -->
            <!-- ══════════════════════════════ -->



            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_start_simulation"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:text="START SIMULATION"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:letterSpacing="0.08"
                android:backgroundTint="@color/primary_button"
                app:cornerRadius="32dp"
                android:layout_marginBottom="16dp" />




            <!-- VR Headset Status -->

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <include
        android:id="@+id/footer"
        layout="@layout/footer" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>