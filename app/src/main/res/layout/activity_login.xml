<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/login_background"
    tools:context=".LoginActivity">

    <!-- Decorative radial background pulse -->
    <View
        android:layout_width="500dp"
        android:layout_height="500dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_radial_pulse"
        android:alpha="0.6" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:fitsSystemWindows="true">

        <!-- ── TOP APP BAR ─────────────────────────────────────────── -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:paddingHorizontal="8dp">

            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Back"
                android:padding="8dp"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/login_text_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:fontFamily="@font/space_grotesk"
                android:text="@string/app_name"
                android:textColor="@color/login_text_primary"
                android:textSize="22sp"
                android:textStyle="bold"
                android:letterSpacing="-0.03" />

        </RelativeLayout>

        <!-- ── SCROLLABLE CONTENT ──────────────────────────────────── -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingHorizontal="32dp"
                android:paddingBottom="48dp">

                <!-- ── LOGO ──────────────────────────────────────────── -->
                <!-- Badge bouclier -->
                <FrameLayout
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_shield_badge"
                    android:elevation="8dp">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_gravity="center"
                        android:contentDescription="Shield Lock"
                        android:src="@drawable/ic_shield_lock"
                        app:tint="@color/on_primary_container" />

                </FrameLayout>

                <!-- ── HEADLINE ───────────────────────────────────────── -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:fontFamily="@font/space_grotesk"
                    android:gravity="center"
                    android:text="@string/login_title"
                    android:textColor="@color/login_text_primary"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:letterSpacing="-0.03" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="40dp"
                    android:fontFamily="@font/manrope"
                    android:gravity="center"
                    android:text="@string/login_subtitle"
                    android:textColor="@color/login_text_secondary"
                    android:textSize="17sp"
                    android:alpha="0.8" />

                <!-- ── PHONE INPUT ─────────────────────────────────────── -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Label -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_marginBottom="8dp"
                        android:alpha="0.6"
                        android:fontFamily="@font/manrope"
                        android:letterSpacing="0.15"
                        android:text="@string/label_mobile_number"
                        android:textAllCaps="true"
                        android:textColor="@color/login_text_secondary"
                        android:textSize="10sp"
                        tools:ignore="SmallSp" />

                    <!-- Country + Phone Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:baselineAligned="false">

                        <!-- Country Selector -->
                        <LinearLayout
                            android:id="@+id/layout_country_selector"
                            android:layout_width="wrap_content"
                            android:layout_height="60dp"
                            android:layout_marginEnd="12dp"
                            android:background="@drawable/bg_input_adaptive"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="16dp"
                            android:clickable="true"
                            android:focusable="true">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="6dp"
                                android:text="🇲🇦"
                                android:textSize="22sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="4dp"
                                android:fontFamily="@font/space_grotesk"
                                android:text="@string/country_code"
                                android:textColor="@color/login_text_primary"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:src="@drawable/ic_expand_more"
                                android:contentDescription="Expand"
                                app:tint="@color/login_text_secondary" />

                        </LinearLayout>

                        <!-- Phone Input -->
                        <EditText
                            android:id="@+id/et_phone"
                            android:layout_width="0dp"
                            android:layout_height="60dp"
                            android:layout_weight="1"
                            android:autofillHints=""
                            android:background="@drawable/bg_input_adaptive"
                            android:backgroundTint="@null"
                            android:fontFamily="@font/space_grotesk"
                            android:gravity="center_vertical"
                            android:hint="@string/hint_phone"
                            android:imeOptions="actionDone"
                            android:inputType="phone"
                            android:maxLength="9"
                            android:paddingHorizontal="20dp"
                            android:textColor="@color/login_text_primary"
                            android:textColorHint="@color/login_hint"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            tools:ignore="VisualLintTextFieldSize" />

                    </LinearLayout>

                    <!-- Error -->
                    <TextView
                        android:id="@+id/tv_phone_error"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_marginTop="6dp"
                        android:fontFamily="@font/manrope"
                        android:textColor="@color/error"
                        android:textSize="12sp"
                        android:visibility="gone"
                        tools:text="@string/error_invalid_phone"
                        tools:visibility="visible" />

                    <!-- Send Code Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_send_code"
                        style="@style/Widget.SafeNow.Button.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="72dp"
                        android:layout_marginTop="24dp"
                        android:text="@string/btn_send_code"
                        app:icon="@drawable/ic_arrow_forward"
                        app:iconGravity="end"
                        app:iconTint="@color/on_primary"
                        tools:ignore="VisualLintButtonSize" />

                    <!-- Terms -->
                    <TextView
                        android:id="@+id/tv_terms"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="20dp"
                        android:layout_marginHorizontal="16dp"
                        android:fontFamily="@font/manrope"
                        android:gravity="center"
                        android:textColor="@color/login_text_secondary"
                        android:textSize="13sp"
                        android:alpha="0.6"
                        android:lineSpacingMultiplier="1.4" />

                </LinearLayout>

                <!-- ── INFO CARDS ──────────────────────────────────────── -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="48dp"
                    android:orientation="horizontal"
                    android:baselineAligned="false">

                    <!-- Card Encryption -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_info_card_adaptive"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_marginBottom="12dp"
                            android:src="@drawable/ic_verified_user"
                            android:contentDescription="Encrypted"
                            app:tint="@color/on_primary_container" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp"
                            android:fontFamily="@font/space_grotesk"
                            android:text="@string/card_encryption_title"
                            android:textColor="@color/login_text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/manrope"
                            android:text="@string/card_encryption_desc"
                            android:textColor="@color/login_text_secondary"
                            android:textSize="11sp"
                            android:lineSpacingMultiplier="1.3" />

                    </LinearLayout>

                    <!-- Card Safety -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_info_card_adaptive"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_marginBottom="12dp"
                            android:src="@drawable/ic_location_on"
                            android:contentDescription="Safety"
                            app:tint="@color/on_primary_container" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp"
                            android:fontFamily="@font/space_grotesk"
                            android:text="@string/card_safety_title"
                            android:textColor="@color/login_text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/manrope"
                            android:text="@string/card_safety_desc"
                            android:textColor="@color/login_text_secondary"
                            android:textSize="11sp"
                            android:lineSpacingMultiplier="1.3" />

                    </LinearLayout>

                </LinearLayout>

                <!-- Footer pill -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center">

                    <View
                        android:layout_width="128dp"
                        android:layout_height="4dp"
                        android:background="@drawable/bg_footer_pill" />

                </LinearLayout>

            </LinearLayout>
        </ScrollView>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>