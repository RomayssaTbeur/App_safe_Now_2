<?xml version="1.0" encoding="utf-8"?>

<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="#F7F3E9"
    app:strokeColor="#1AC2C6D1"
    app:strokeWidth="1dp"
    android:foreground="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp">

        <!-- Avatar -->
        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/iv_avatar"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:src="@drawable/ic_account_circle"
            app:civ_border_color="#E6E2D8"
            app:civ_border_width="2dp"
            android:layout_marginEnd="14dp"
            tools:ignore="MissingClass" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_contact_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sarah Miller"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#1C1C16"
                android:fontFamily="@font/space_grotesk_bold" />

            <TextView
                android:id="@+id/tv_contact_role"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Spouse • Emergency Contact"
                android:textSize="12sp"
                android:textColor="#424750"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/manrope_medium" />

        </LinearLayout>

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginStart="8dp">

            <!-- Chat Button -->
            <androidx.cardview.widget.CardView
                android:id="@+id/btn_chat"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="8dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF"
                android:foreground="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="Send message"
                    app:srcCompat="@drawable/ic_chat"
                    app:tint="#002A54" />

            </androidx.cardview.widget.CardView>

            <!-- Call Button -->
            <androidx.cardview.widget.CardView
                android:id="@+id/btn_call"
                android:layout_width="44dp"
                android:layout_height="44dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="#002A54"
                android:foreground="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="Call contact"
                    app:srcCompat="@drawable/ic_call"
                    app:tint="#FFFFFF" />

            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>